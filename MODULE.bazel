module(name = "cxx-qt-bazel")

bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "rules_rs", version = "0.1.3")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "cxx.rs", version = "1.0.205")

bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "llvm", version = "0.8.26")


toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains", dev_dependency = True)
toolchains.toolchain(
    edition = "2024",
    version = "1.99.0",
)

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

use_repo(toolchains, "default_rust_toolchains")
register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
    dev_dependency = True
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "cxx_qt_crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-pc-windows-gnullvm",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-gnu",
        "x86_64-pc-windows-gnullvm",
        "x86_64-unknown-linux-gnu",
    ],
)

use_repo(crate, "cxx_qt_crates")

inject_repo(crate, "cxx-qt-bazel")
inject_repo(crate, "qt")
inject_repo(crate, "cxx.rs")

include("//third_party:qt_crates.include.MODULE.bazel")
# include("//third_party:cxx-qt.MODULE.bazel")
# include("//third_party:cxx-qt-lib.MODULE.bazel")
# include("//third_party:qtbridge-type-lib.MODULE.bazel")
# include("//third_party:qtbridge-runtime.MODULE.bazel")
# include("//third_party:qtbridge-interfaces.MODULE.bazel")

qt_download = use_extension("@cxx-qt-bazel//cxx-qt-bazel:extensions.bzl", "qt_download")

use_repo(qt_download, "qt", "qt_osx", "qt_win_x86")

register_toolchains(
  "//toolchains:all",
)
