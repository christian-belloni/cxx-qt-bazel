module(name = "cxx-qt-bazel")

bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_rs", version = "0.1.3")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "cxx.rs", version = "1.0.205")

bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "llvm", version = "0.8.26")
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "22.1.0")

# Can drop windows_support once @llvm has a bumped version!
bazel_dep(name = "windows_support", version = "0.4.1")

msvc_runtime = use_extension("@windows_support//windows:extensions.bzl", "msvc_runtime")
msvc_runtime.configure(
  msvc_version = "14.50.35717",
  visual_studio_installer_manifest_url = "https://download.visualstudio.microsoft.com/download/pr/fdc37f6e-59f6-4054-838a-b476eeaa6ec3/1d82370739911457e0a2f6be15d8b5f569531b352b2eabb961429eea1e99e356/VisualStudio.vsman",
  visual_studio_installer_manifest_integrity = "sha256-qOhU+p8/uurCfXME4pfxZg1xN0ATid61fPeYPzPBb+8=",
)
use_repo(msvc_runtime, "msvc_runtime")

windows_sdk = use_extension("@windows_support//windows:extensions.bzl", "windows_sdk")
windows_sdk.configure(
    windows_sdk_version = "10.0.26100.7705",
)
use_repo(windows_sdk, "windows_sdk")


toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains", dev_dependency = True)
toolchains.toolchain(
    edition = "2024",
    version = "1.99.0",
)

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

use_repo(toolchains, "default_rust_toolchains")
register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
    dev_dependency = True
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "cxx_qt_crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-pc-windows-gnullvm",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-pc-windows-gnu",
        "x86_64-pc-windows-gnullvm",
        "x86_64-unknown-linux-gnu",
    ],
)

use_repo(crate, "cxx_qt_crates")

inject_repo(crate, "cxx-qt-bazel")
inject_repo(crate, "qt")
inject_repo(crate, "cxx.rs")

include("//third_party:qt_crates.include.MODULE.bazel")
# include("//third_party:cxx-qt.MODULE.bazel")
# include("//third_party:cxx-qt-lib.MODULE.bazel")
# include("//third_party:qtbridge-type-lib.MODULE.bazel")
# include("//third_party:qtbridge-runtime.MODULE.bazel")
# include("//third_party:qtbridge-interfaces.MODULE.bazel")

qt_download = use_extension("@cxx-qt-bazel//cxx-qt-bazel:extensions.bzl", "qt_download")

use_repo(qt_download, "qt", "qt_osx", "qt_win_x86")

register_toolchains(
  "//toolchains:all",
)
